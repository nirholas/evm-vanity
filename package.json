{
  "name": "evm-vanity",
  "version": "1.0.0",
  "description": "Open-source EVM vanity wallet generator: grind a 0x address in your browser across every core, delegate hard patterns with secp256k1 split-key grinding that cannot expose your key, and verify EIP-712 provenance certificates on chain. Works on Ethereum, Base, Arbitrum, Robinhood Chain and any EVM network.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "nirholas <support@three.ws>",
  "homepage": "https://github.com/nirholas/evm-vanity",
  "repository": { "type": "git", "url": "git+https://github.com/nirholas/evm-vanity.git" },
  "bugs": { "url": "https://github.com/nirholas/evm-vanity/issues" },
  "keywords": [
    "ethereum", "evm", "vanity", "vanity-address", "vanity-wallet", "address-generator",
    "secp256k1", "keccak", "eip55", "eip712", "split-key", "profanity", "base", "arbitrum",
    "robinhood-chain", "mcp", "agent", "web3", "wallet"
  ],
  "bin": { "evm-vanity": "cli/evm-vanity.js" },
  "exports": {
    ".": "./src/index.js",
    "./address": "./src/address.js",
    "./split-key": "./src/split-key.js",
    "./attestation": "./src/attestation.js",
    "./chains": "./src/chains.js",
    "./package.json": "./package.json"
  },
  "files": ["src", "cli", "mcp", "server", "docs", "README.md", "LICENSE", "NOTICE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"vite\" \"node --watch server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.js",
    "mcp": "node mcp/index.js",
    "keygen": "node server/keygen.mjs",
    "deploy:cf": "npm run build && npx wrangler deploy",
    "deploy:pages": "npm run build && npx wrangler pages deploy dist --project-name evm-vanity"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^1.8.0",
    "ethers": "^6.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "three": "^0.184.0",
    "vite": "^7.3.0",
    "wrangler": "^4.40.0"
  },
  "publishConfig": { "access": "public" }
}
